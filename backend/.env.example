# Emerald Life Backend Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!

# Application Environment & Server Port
# On Chabokan, PORT is often assigned automatically or defaults to 3000 / 8080
NODE_ENV=development
PORT=5000

# Reverse Proxy Trust Settings
# Chabokan runs apps behind an Nginx/Traefik reverse proxy.
# Set to 'loopback' or '1' (first proxy hop) for proper IP rate limiting.
# Options: false (direct connection), true, 'loopback', or a hop number like 1
TRUST_PROXY=1

# Allowed CORS Origins (comma-separated without trailing slash)
ALLOWED_ORIGINS=https://sanastudio.ir,https://www.sanastudio.ir,http://localhost:5173,http://localhost:3000

# Gmail SMTP Configuration for Nodemailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sanaheydari245@gmail.com
# Google App Password (16 letters generated from Google Account > Security > 2-Step Verification > App Passwords)
SMTP_PASS=your_16_character_app_password

# Destination Inbox for Contact Form Messages
MAIL_TO=sanaheydari245@gmail.com

# Optional sender display name
MAIL_FROM_NAME="Emerald Life Contact Form"

# Cloudflare Turnstile Bot Protection Configuration
# Options for TURNSTILE_MODE: 'disabled' (default if no secret), 'required' (enforced)
TURNSTILE_MODE=disabled
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_EXPECTED_ACTION=contact
TURNSTILE_EXPECTED_HOSTNAME=sanastudio.ir
