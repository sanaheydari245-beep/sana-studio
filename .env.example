# ==============================================================================
# Emerald Life - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or '.env.local') and fill in the values.
# IMPORTANT: Never commit the actual '.env' file containing real secrets to git.

# Base Public URL for SEO, Canonical URLs and Sitemap
VITE_SITE_URL=https://sanastudio.ir

# Dedicated Chabokan Node.js Backend API Base URL
# In local development: http://localhost:5000
# In production on Chabokan: https://api.sanastudio.ir or your Chabokan assigned domain
# When omitted, relative '/api/contact' is used via same-origin reverse proxy
VITE_API_BASE_URL=

# Official Contact Email
VITE_CONTACT_EMAIL=sanaheydari245@gmail.com

# Cloudflare Turnstile Bot Protection (Optional / Recommended)
# Obtain from Cloudflare Dashboard > Turnstile.
# When provided, the Turnstile challenge widget renders automatically on the contact form.
VITE_TURNSTILE_SITE_KEY=
