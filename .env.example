# ==============================================================================
# Sana Studio - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' (or '.env.local') and fill in the values.
# IMPORTANT: Never commit the actual '.env' file containing real secrets to git.

# Base Public URL for SEO, Canonical URLs and Sitemap
VITE_SITE_URL=https://sanastudio.ir

# Dedicated Chabokan Node.js Backend API Base URL
# In local development: http://localhost:5000
# In production on Chabokan: https://api.sanastudio.ir or your Chabokan assigned domain
# If omitted or left empty, the frontend gracefully falls back to EmailJS or direct mailto.
VITE_API_BASE_URL=

# Official Studio Recipient Email
VITE_CONTACT_EMAIL=sanaheydari245@gmail.com

# ------------------------------------------------------------------------------
# Temporary Fallback: EmailJS Contact Form Configuration
# ------------------------------------------------------------------------------
# This remains active as a reliable backup until the dedicated backend is fully
# verified in production on Chabokan.
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
